# Original and normalized game data. Never commit cartridges, archives, or extracts.
top_gear_rom/**
*.n64
*.v64
*.z64
*.rom
*.zip

# Local build products and code/assets generated from the user's dump.
/build/
/build-*/
/generated/
/config/asm/
/config/assets/
/config/include/
/config/build/
/config/topgearoverdrive.ld
/config/undefined_*
/tools/.pydeps/
/RecompiledFuncs/
/RecompiledFuncsPoint*/
/rsp/
*.elf
*.o
*.obj
*.exe
*.dll
*.pdb

# Per-user runtime data and capture files.
tgod.ini
*.sav
*.srm
*.eep
*.fla
*.mpk
/captures/
/screenshots/

# Dependencies are fetched from pinned upstream repositories; publish patches only.
/tools/N64ModernRuntime/
/tools/N64Recomp/
/saves/
*.bin
*.bmp
*.png
*.jpg
*.jpeg
*.wav
*.raw
*.mp3
*.ogg
*.log
*.tmp
.temp
.env
.env.*
*.pem
*.key
*.pfx
__pycache__/
